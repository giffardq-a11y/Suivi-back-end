# Copie ce fichier en `.env` et remplis les valeurs — ne commit jamais le
# vrai `.env` (secrets réels dedans).

# Adresse publique du backend, utilisée pour construire les URIs de
# redirection OAuth (doit correspondre à ce que tu déclares chez Google/
# Microsoft). En local avec ngrok/tunnel, mets l'URL du tunnel plutôt que
# localhost — Google et Microsoft ne peuvent pas rediriger vers ta machine
# si elle n'est pas exposée publiquement.
BACKEND_BASE_URL=http://localhost:8000

# Google Calendar — voir les instructions dans app/routers/integrations.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft Calendar — voir les instructions dans app/routers/integrations.py
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Estimation de calories par photo — voir les instructions dans
# app/routers/meal_photo.py. Deux fournisseurs au choix (proposés à
# l'utilisateur dans l'app) via MEAL_PHOTO_PROVIDER : "gemini_fatsecret"
# (natif, gratuit, par défaut) ou "logmeal" (option payante).
MEAL_PHOTO_PROVIDER=gemini_fatsecret

# Option native : Gemini + FatSecret (gratuite)
GEMINI_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Option payante : LogMeal (précision supérieure, abonnement au-delà de l'essai)
LOGMEAL_API_KEY=

# Recherche d'aliments (USDA FoodData Central) — voir les instructions
# dans app/routers/food_search.py. Gratuit, DEMO_KEY fonctionne pour
# tester mais avec une limite de débit basse.
FDC_API_KEY=

# Déjà utilisé ailleurs dans le projet (auth JWT) — génère une vraie valeur
# aléatoire en prod, ne garde pas la valeur de dev.
JWT_SECRET=dev-secret-change-me
